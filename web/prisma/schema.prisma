generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  date        DateTime
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  rsvps     RSVP[]
  favorites Favorite[]
}

model RSVP {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

enum StoryStatus {
  PENDING
  APPROVED
  REJECTED
}

model Story {
  id        String      @id @default(cuid())
  authorId  String
  title     String
  content   String
  status    StoryStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  author UserAccess @relation(fields: [authorId], references: [authUserId], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

enum AccountStatus {
  PENDING
  APPROVED
  BLOCKED
}

model UserAccess {
  authUserId String        @id
  email      String        @unique
  name       String
  status     AccountStatus @default(PENDING)
  isAdmin    Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  profile MemberProfile?
  stories Story[]

  @@index([status, createdAt])
}

model MemberProfile {
  id         String @id @default(cuid())
  authUserId String @unique

  // Personal information
  displayName String
  location    String?
  occupation  String?
  bio         String? @db.Text
  photoUrl    String?

  // Activity interests
  interests String[] @default([])

  // Optional story or testimony
  storyTitle String?
  story      String? @db.Text
  storyType  String?

  // Privacy and communication
  shareProfile  Boolean @default(false)
  shareStory    Boolean @default(false)
  allowMessages Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link profile to approved account record
  userAccess UserAccess @relation(fields: [authUserId], references: [authUserId], onDelete: Cascade)
}
