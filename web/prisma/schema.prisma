generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  date        DateTime
  image       String?
  capacity    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  rsvps     RSVP[]
  favorites Favorite[]
}

model RSVP {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

enum AccountStatus {
  PENDING
  APPROVED
  BLOCKED
}

model UserAccess {
  authUserId String        @id
  email      String        @unique
  name       String
  status     AccountStatus @default(PENDING)
  isAdmin    Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  profile MemberProfile?

  sentConnections     ConnectionRequest[] @relation("SentConnections")
  receivedConnections ConnectionRequest[] @relation("ReceivedConnections")
  groupMemberships    GroupMembership[]
  createdGroups       Group[]             @relation("CreatedGroups")

  @@index([status, createdAt])
}

model MemberProfile {
  id         String @id @default(cuid())
  authUserId String @unique

  // Personal information
  displayName String
  location    String?
  occupation  String?
  bio         String? @db.Text
  photoUrl    String?

  // Activity interests
  interests String[] @default([])

  // Optional story or testimony
  storyTitle String?
  story      String? @db.Text
  storyType  String?

  // Privacy and communication
  shareProfile  Boolean @default(false)
  shareStory    Boolean @default(false)
  allowMessages Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link profile to approved account record
  userAccess UserAccess @relation(fields: [authUserId], references: [authUserId], onDelete: Cascade)
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model ConnectionRequest {
  id          String           @id @default(cuid())
  senderId    String
  recipientId String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender    UserAccess @relation("SentConnections", fields: [senderId], references: [authUserId], onDelete: Cascade)
  recipient UserAccess @relation("ReceivedConnections", fields: [recipientId], references: [authUserId], onDelete: Cascade)

  messages ConnectionMessage[]

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
}

model ConnectionMessage {
  id           String    @id @default(cuid())
  connectionId String
  senderId     String
  content      String    @db.Text
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  connection ConnectionRequest @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
}

enum GroupStatus {
  PENDING
  APPROVED
  REJECTED
}

model Group {
  id              String      @id @default(cuid())
  name            String
  description     String      @db.Text
  meetingSchedule String      @db.Text
  location        String
  status          GroupStatus @default(PENDING)
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Administrator review and member notification
  reviewedAt               DateTime?
  reviewNotificationReadAt DateTime?
  reviewFeedback           String?   @db.Text

  creator UserAccess? @relation("CreatedGroups", fields: [createdById], references: [authUserId], onDelete: SetNull)

  memberships GroupMembership[]

  @@index([name])
  @@index([status, createdAt])
  @@index([createdById])
  @@index([createdById, reviewNotificationReadAt])
}

model GroupMembership {
  id         String   @id @default(cuid())
  groupId    String
  authUserId String
  joinedAt   DateTime @default(now())

  group  Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member UserAccess @relation(fields: [authUserId], references: [authUserId], onDelete: Cascade)

  @@unique([groupId, authUserId])
  @@index([authUserId, joinedAt])
}
